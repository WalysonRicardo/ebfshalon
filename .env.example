# Copie este arquivo para .env.local ao rodar localmente com `vercel dev`.
# Na Vercel (produção), configure estas variáveis em:
# Project Settings > Environment Variables

# Senha para acessar /admin.html (a área da equipe)
ADMIN_PASSWORD=ibshalonkids

# KV_REST_API_URL e KV_REST_API_TOKEN são preenchidas automaticamente
# quando você cria e conecta um banco Vercel KV ao projeto — não precisa
# copiar manualmente, mas ficam assim:
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
